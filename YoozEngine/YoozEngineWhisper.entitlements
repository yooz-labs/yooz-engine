<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    YoozEngineWhisper.entitlements — A5 (#29).

    Starts identical to YoozEngine.entitlements so the slim helper has the
    same capabilities as the full variant (network server + client, no
    sandbox). Split exists so future whisper-only tweaks (e.g. a narrower
    permission set once VAD stays whisper-side and Apple STT is the only
    mic consumer in-helper) don't churn the full engine's entitlements.

    See .context/a5_handoff.md §"Entitlements" for the split rationale.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
