# Xcode
xcuserdata/
*.xcodeproj
*.xcworkspace
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
build/

# Swift Package Manager
# .build is a symlink to /Volumes/S1/.../yooz-engine/.build on dev machines,
# so the trailing-slash form does not match. Use the slashless form.
.build
.build/
.swiftpm/
# Package.resolved IS committed to enforce the SharpAI mlx-swift /
# mlx-swift-lm pins called out in project.yml. See issue #10.

# Release artifacts (built locally by scripts/release-engine.sh)
dist/

# Models (large binary files)
YoozEngine/Resources/Models/*.mlpackage
YoozEngine/Resources/Models/*.safetensors
YoozEngine/Resources/Models/*.gguf
YoozEngine/Resources/model.safetensors
YoozEngine/Resources/config.json

# Rust build artifacts
text-cleanup/target/
text-cleanup/build/

# Vendor is a build-output dir for the Rust xcframework. The whole tree is
# regenerated by scripts/build-engine-*.sh; nothing here should ever be
# committed. The previous, narrower rule (Vendor/YoozTextCleanup/...xcframework)
# left the parent dir showing up as untracked on every checkout.
Vendor/

# Context docs (project-local)
.context/

# Python (engine has none today; rules stay in case a tool drops a venv).
# Training/finetune material lives in private yooz-benchmark.
.venv/
__pycache__/
*.pyc
.envrc

# LLVM raw coverage (xcodebuild -enableCodeCoverage drops these at repo root)
*.profraw

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Reference repos cloned for research (issue #10 TurboQuant)
external/
